# ==================================================
# .env - Configuración de Desarrollo
# ==================================================

# 🌍 Entorno
NODE_ENV=development
PORT=5000

# 🗄️ Base de datos
DB_URI=mongodb://localhost:27017/ravello

# 🔐 Seguridad
JWT_SECRET=your_jwt_secret_here_change_in_production

# 🌐 URLs de la aplicación
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# 📧 Configuración de Email
# ⚙️ ENABLE_EMAILS: Controla si se envían emails realmente
#    - true: Envía emails (útil para testing en desarrollo)
#    - false: Solo registra en consola (recomendado para desarrollo local)
#    - Si no se especifica, usa NODE_ENV (solo en production)
ENABLE_EMAILS=false

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=tu-correo@gmail.com
EMAIL_PASS=tu-contraseña-o-app-password
CONTACT_EMAIL=destino@ejemplo.com
ADMIN_EMAIL=admin@ejemplo.com
SITE_NAME=Ravello Travel

# 🔥 Firebase Storage
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account", ... }'
FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com

# 💳 MercadoPago
MERCADOPAGO_ACCESS_TOKEN=tu_access_token_aqui
MERCADOPAGO_PUBLIC_KEY=tu_public_key_aqui

# 📊 Logs y depuración
LOG_LEVEL=debug
ENABLE_QUERY_LOGGING=true

# ==================================================
# EJEMPLOS DE USO:
# ==================================================

# Desarrollo sin enviar emails (recomendado):
# ENABLE_EMAILS=false

# Desarrollo pero probando envío de emails:
# ENABLE_EMAILS=true
# EMAIL_USER=tu-email-de-pruebas@gmail.com
# EMAIL_PASS=tu-app-password

# ==================================================
# .env.production - Para producción
# ==================================================

# 🌍 Entorno
# NODE_ENV=production
# PORT=5000

# 🗄️ Base de datos
# DB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/ravello

# 🔐 Seguridad
# JWT_SECRET=un_secreto_super_seguro_y_largo_generado_aleatoriamente

# 🌐 URLs
# FRONTEND_URL=https://tu-dominio.com
# BACKEND_URL=https://api.tu-dominio.com

# 📧 Email (EN PRODUCCIÓN SIEMPRE HABILITADO)
# ENABLE_EMAILS=true
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_USER=contacto@tu-dominio.com
# EMAIL_PASS=tu-app-password-seguro
# CONTACT_EMAIL=contacto@tu-dominio.com
# ADMIN_EMAIL=admin@tu-dominio.com
# SITE_NAME=Ravello Travel

# 🔥 Firebase
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account", ... }'
# FIREBASE_STORAGE_BUCKET=tu-proyecto-prod.appspot.com

# 💳 MercadoPago
# MERCADOPAGO_ACCESS_TOKEN=tu_access_token_de_produccion
# MERCADOPAGO_PUBLIC_KEY=tu_public_key_de_produccion

# 📊 Logs
# LOG_LEVEL=info
# ENABLE_QUERY_LOGGING=false

# ==================================================
# .env.testing - Para testing con emails
# ==================================================

# NODE_ENV=development
# PORT=5000
# DB_URI=mongodb://localhost:27017/ravello_test

# 📧 Habilitar emails para probar
# ENABLE_EMAILS=true
# EMAIL_USER=email-de-testing@gmail.com
# EMAIL_PASS=app-password-testing
# ADMIN_EMAIL=tu-email-personal@gmail.com

# ==================================================
# .env.example - Template para otros desarrolladores
# ==================================================

# 🌍 Entorno
# NODE_ENV=development
# PORT=5000

# 🗄️ Base de datos
# DB_URI=mongodb://localhost:27017/ravello

# 🔐 Seguridad
# JWT_SECRET=cambiar_este_secreto

# 🌐 URLs
# FRONTEND_URL=http://localhost:3000
# BACKEND_URL=http://localhost:5000

# 📧 Email
# ENABLE_EMAILS=false                    # true para enviar, false para simular
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_USER=tu-correo@gmail.com
# EMAIL_PASS=tu-app-password
# CONTACT_EMAIL=destino@ejemplo.com
# ADMIN_EMAIL=admin@ejemplo.com
# SITE_NAME=Ravello Travel

# 🔥 Firebase
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account", ... }'
# FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com

# 💳 MercadoPago
# MERCADOPAGO_ACCESS_TOKEN=tu_access_token
# MERCADOPAGO_PUBLIC_KEY=tu_public_key