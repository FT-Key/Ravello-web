NODE_ENV=development
PORT=5000
DB_URI=mongodb://localhost:27017/ravello
JWT_SECRET=your_jwt_secret_here
# 🌍 URL del frontend (opcional, usada en correos o redirecciones)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000


# 📬 Configuración del servidor de correo
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=tu-correo@gmail.com
EMAIL_PASS=tu-contraseña-o-app-password

# 📥 Dónde recibirás los mensajes del formulario
CONTACT_EMAIL=destino@ejemplo.com
SITE_NAME=Mi Web

FIREBASE_SERVICE_ACCOUNT='{"type":"service_account", ... }'   # TODO: pone el JSON aquí o usa archivo en servidor
FIREBASE_STORAGE_BUCKET="tu-proyecto.appspot.com"

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=tu_access_token_aqui